NODE_ENV=production
APP_PORT=3000
TRUST_PROXY=true

# Managed PostgreSQL 16+ with pgvector enabled
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eduai
DATABASE_SSL=true
DB_POOL_MAX=20

# Managed Redis 7+
REDIS_URL=rediss://:PASSWORD@HOST:6379
RAG_WORKER_CONCURRENCY=2
RAG_PROCESSOR_MODULE=
RUN_RAG_WORKER=true

# Secret manager / deployment environment only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Billing secrets are configured only when billing is enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://YOUR_DOMAIN/dashboard.html?billing=success
STRIPE_CANCEL_URL=https://YOUR_DOMAIN/dashboard.html?billing=cancel
