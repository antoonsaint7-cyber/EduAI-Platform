NODE_ENV=production
PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_ai
DATABASE_SSL=false
DB_POOL_SIZE=10
AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOW_TEACHER_SIGNUP=false
GROUNDING_THRESHOLD=0.90
API_RATE_LIMIT=60
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=curricula
