NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
DATABASE_SSL=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
REALTIME_MODEL=gpt-realtime-2.1
MULTIMODAL_MODEL=gpt-5.6-luna
GROUNDING_THRESHOLD=0.9

# Payments
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_TEACHER=
STRIPE_PRICE_SCHOOL=

# Transactional email
RESEND_API_KEY=
EMAIL_FROM=EduAI <no-reply@example.com>
PUBLIC_BASE_URL=https://app.example.com

# S3-compatible object storage
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=curricula
S3_SSE=AES256

# Observability
OTEL_SERVICE_NAME=educational-platform
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com

# Security
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
